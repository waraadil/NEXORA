# ─────────────────────────────────────────────────────────────
# NEXORA — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# Anything readable by the browser must be prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Bypasses RLS — never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 64 hex characters: openssl rand -hex 32
# Encrypts provider API keys with AES-256-GCM before they reach the database.
NEXORA_ENCRYPTION_KEY=

# Absolute public URL, used to build OAuth redirects and webhook URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
